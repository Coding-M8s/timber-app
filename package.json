{
  "name": "timber-app",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Desktop app for Timber: every worktree, agent, and terminal in one window.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [],
  "scripts": {
    "dev:web": "vite --port 5173 --strictPort",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 --timeout=30000 --timings tests/timings.json",
    "test:serial": "bun test --timeout=30000",
    "icons": "bun scripts/make-icons.ts",
    "check:attribution": "bun --no-env-file scripts/check-commit-attribution.ts",
    "prepare:devkit": "electrobun prepare",
    "hmr": "electrobun prepare && vite --port 5173 --strictPort",
    "start": "electrobun prepare && vite build && electrobun dev",
    "dev": "electrobun prepare && vite build && electrobun dev --watch",
    "dev:hmr": "concurrently --kill-others --success first \"bun run hmr\" \"bun run start\"",
    "typecheck:desktop": "electrobun prepare && tsc --noEmit -p tsconfig.desktop.json",
    "fetch:timber": "bun scripts/fetch-timber.ts",
    "build": "bun scripts/fetch-timber.ts && electrobun prepare && vite build && electrobun build --env=stable",
    "build:canary": "bun scripts/fetch-timber.ts && electrobun prepare && vite build && electrobun build --env=canary"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "marked": "18.1.3",
    "material-icon-theme": "5.40.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "style-mod": "4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electrobun": "2.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
